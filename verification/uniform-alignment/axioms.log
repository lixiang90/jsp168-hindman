def Hindman168.HasUniformSelectedPrincipalAlignment.{u} : Prop :=
∀ (n r s : ℕ),
  ∃ B A,
    ∃ (hclosed : Hindman168.FiniteScaleClosure B A),
      B.Nonempty ∧
        (∀ b ∈ B, ∀ (i : Fin n), 0 < b i) ∧
          (∀ a ∈ A, 0 < a) ∧
            ∃ δ,
              0 < δ ∧
                ∀ (d M : ℕ) (hM : 0 < M) (P : Finset (MvPolynomial (Fin d) ℤ)) (F : Hindman168.MasterParameterFamily),
                  Hindman168.MasterParameterConditions M A P F →
                    ∀ (e : Fin (2 * n) ↪o ℕ),
                      (∀ (j : Fin (2 * n)), e j < M) →
                        ∀ (S : Finset (Fin n) → Fin n → Hindman168.ScaleColorIndex A r → ℕ → ℤ → ℝ),
                          (∀ (T : Finset (Fin n)) (i : Fin n) (γ : Hindman168.ScaleColorIndex A r),
                              Hindman168.NativePieceRepresented s F
                                (Hindman168.masterGapIndex M hM (Hindman168.energyPadding e i)) (S T i γ)) →
                            (∀ (T : Finset (Fin n)) (i : Fin n) (γ : Hindman168.ScaleColorIndex A r) (w : ℕ) (y : ℤ),
                                S T i γ w y ∈ Set.Icc 0 1) →
                              ∀ (θ : ℝ),
                                0 < θ →
                                  δ ≤
                                    Filter.liminf
                                      (fun w =>
                                        Hindman168.FiniteMass.event (Hindman168.selectedPrincipalRawMass e F w)
                                          (Hindman168.PrincipalSumAlignmentEvent M e B A hclosed S θ w))
                                      Filter.atTop
Hindman168.hasUniformSelectedPrincipalAlignment.{u} : Hindman168.HasUniformSelectedPrincipalAlignment
