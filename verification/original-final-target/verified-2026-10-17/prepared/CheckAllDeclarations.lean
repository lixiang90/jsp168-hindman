  let env ← getEnv
  let targets : Array Name := (#[auditTargetChunk000, auditTargetChunk001, auditTargetChunk002, auditTargetChunk003, auditTargetChunk004, auditTargetChunk005, auditTargetChunk006, auditTargetChunk007, auditTargetChunk008, auditTargetChunk009, auditTargetChunk010, auditTargetChunk011, auditTargetChunk012, auditTargetChunk013, auditTargetChunk014, auditTargetChunk015, auditTargetChunk016, auditTargetChunk017, auditTargetChunk018, auditTargetChunk019, auditTargetChunk020, auditTargetChunk021, auditTargetChunk022, auditTargetChunk023, auditTargetChunk024, auditTargetChunk025, auditTargetChunk026, auditTargetChunk027, auditTargetChunk028, auditTargetChunk029, auditTargetChunk030, auditTargetChunk031, auditTargetChunk032, auditTargetChunk033, auditTargetChunk034, auditTargetChunk035, auditTargetChunk036, auditTargetChunk037, auditTargetChunk038, auditTargetChunk039] : Array (Array Name)).flatten
  let mut found : Std.HashSet Name := {}
  let mut seen : Std.HashSet Name := {}
  let mut records : Nat := 0
  for i in [:env.header.moduleNames.size] do
    let moduleName := env.header.moduleNames[i]!
    if targets.contains moduleName then
      found := found.insert moduleName
      let mut count : Nat := 0
      for name in env.header.moduleData[i]!.constNames do
        count := count + 1
        records := records + 1
        seen := seen.insert name
        let axioms ← collectAxioms name
        for ax in axioms do
          unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
            throwError m!"Unexpected axiom {ax} in {moduleName}: {name}"
        logInfo m!"AUDIT DECL: {moduleName}; {name}; axioms: {axioms}"
      logInfo m!"AUDIT MODULE: {moduleName}; all {count} declaration records checked"
  for target in targets do
    unless found.contains target do
      throwError m!"Missing target module: {target}"
  unless seen.size > 0 do
    throwError "Empty declaration audit"
  logInfo m!"AUDIT COMPLETE: {found.size} local modules; {seen.size} unique declarations; {records} records; only standard three axioms"
