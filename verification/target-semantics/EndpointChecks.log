def Hindman168.StrongWitness : {r : ℕ} → {m : ℕ} → (ℕ → Fin r) → ℝ → ℝ → Prop :=
fun {r m} color R D =>
  ∃ a,
    StrictMono.{0, 0} a ∧
      (∀ (i : Fin m), LT.lt.{0} 0 (a i)) ∧
        (∀ (i : Fin m),
            LT.lt.{0}
              (HMul.hMul.{0, 0, 0} R
                (HPow.hPow.{0, 0, 0}
                  (HAdd.hAdd.{0, 0, 0} (∑ j with LT.lt.{0} j i, ↑(a j)) (∏ j with LT.lt.{0} j i, ↑(a j))) D))
              ↑(a i)) ∧
          ∃ c,
            ∀ (S : Finset.{0} (Fin m)),
              Finset.Nonempty.{0} S → Eq.{1} (color (∑ i ∈ S, a i)) c ∧ Eq.{1} (color (∏ i ∈ S, a i)) c
def Hindman168.FiniteConjecture : Prop :=
∀ (r : ℕ) (color : ℕ → Fin r) (m : ℕ), ∃ A, LE.le.{0} m (Finset.card.{0} A) ∧ MonoFSFP color A
def Hindman168.MonoFSFP : {r : ℕ} → (ℕ → Fin r) → Finset.{0} ℕ → Prop :=
fun {r} color A => ∃ c, ∀ S ⊆ A, Finset.Nonempty.{0} S → Eq.{1} (color (∑ x ∈ S, x)) c ∧ Eq.{1} (color (∏ x ∈ S, x)) c
