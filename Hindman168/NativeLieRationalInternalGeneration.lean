import Hindman168.NativeLieRationalCommutatorLeading

/-! The actual internal rational next layer is generated by the actual
native brackets with the current layer. Its genuine rational
exponential image is a subgroup, proved from actual BCH closure. -/

namespace Hindman168
open scoped Manifold ContDiff

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] [Module ℚ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G]

attribute [local instance] lieGroup_smooth_min_three

 theorem nativeLieRationalInternalLayer_succ_le_iff
    (V : Submodule ℚ E) (hbr : nativeLieRationalBracketClosed (I := I) (G := G) V)
    (j : ℕ) (N : Submodule ℚ E) :
    nativeLieRationalInternalLayer (I := I) (G := G) V hbr (j + 1) ≤ N ↔
      ∀ v ∈ V, ∀ w ∈ nativeLieRationalInternalLayer (I := I) (G := G) V hbr j,
        nativeLieAdjointDifferential (I := I) (G := G) v w ∈ N := by
  constructor
  · intro h v hv w hw
    exact h (nativeLieRationalInternalLayer_differential_next V hbr j hv hw)
  · intro h
    let A := nativeLieRationalSubalgebra (I := I) (G := G) V hbr
    change (LieModule.lowerCentralSeries ℚ A A (j + 1)).toSubmodule.map A.incl.toLinearMap ≤ N
    rw [Submodule.map_le_iff_le_comap, LieModule.lowerCentralSeries_succ,
      LieSubmodule.lieIdeal_oper_eq_linear_span', Submodule.span_le]
    rintro z ⟨a, _, b, hb, rfl⟩
    change (⁅a, b⁆ : A).val ∈ N
    have hbm : b.val ∈ nativeLieRationalInternalLayer (I := I) (G := G) V hbr j :=
      (nativeLieRationalInternalLayer_mem_iff V hbr j _).mpr ⟨b, hb, rfl⟩
    have hd := h a.val a.property b.val hbm
    rw [← nativeLieAdjointGenerator_eq_differential (E := E) (I := I) (G := G)] at hd
    have he : nativeLieAdjointGenerator (I := I) (G := G) a.val b.val = (⁅a, b⁆ : A).val :=
      nativeLieAdjointGenerator_eq_native_bracket (I := I) (G := G) a.val b.val
    exact he ▸ hd

 theorem nativeLieRationalInternalLayer_bracket_closed
    (V : Submodule ℚ E) (hbr : nativeLieRationalBracketClosed (I := I) (G := G) V) (j : ℕ) :
    nativeLieRationalBracketClosed (I := I) (G := G)
      (nativeLieRationalInternalLayer (I := I) (G := G) V hbr j) := by
  intro a b ha hb
  have hv := nativeLieRationalInternalLayer_le V hbr j ha
  have hd := nativeLieRationalInternalLayer_ideal V hbr j hv hb
  rw [← nativeLieAdjointGenerator_eq_differential (E := E) (I := I) (G := G)] at hd
  exact (nativeLieAdjointGenerator_eq_native_bracket (I := I) (G := G) a b) ▸ hd

variable [Group.IsNilpotent G] [FiniteDimensional ℝ E]

noncomputable def nativeLieRationalInternalSubgroup
    (V : Submodule ℚ E) (hbr : nativeLieRationalBracketClosed (I := I) (G := G) V) (j : ℕ) :
    Subgroup G :=
  nativeLieRationalExponentialSubgroup (I := I) (G := G)
    (nativeLieRationalInternalLayer (I := I) (G := G) V hbr j)
    (nativeLieRationalInternalLayer_bracket_closed (I := I) (G := G) V hbr j)

variable [ConnectedSpace G] [SimplyConnectedSpace G]

 theorem nativeLieRationalInternalSubgroup_mem_logarithm_iff
    (V : Submodule ℚ E) (hbr : nativeLieRationalBracketClosed (I := I) (G := G) V)
    (j : ℕ) (g : G) :
    g ∈ nativeLieRationalInternalSubgroup (I := I) (G := G) V hbr j ↔
      nativeLieGlobalLogarithm (E := E) (I := I) (G := G) g ∈
        nativeLieRationalInternalLayer (I := I) (G := G) V hbr j :=
  nativeLieRationalExponentialSubgroup_mem_logarithm_iff _ _ g

end Hindman168
