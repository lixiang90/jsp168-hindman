import Hindman168.PolynomialLieDexpRecursion
import Hindman168.UnitriangularPolynomialBCHCurve
import Hindman168.UnitriangularSubalgebraTopology

/-! BCH closure for every Lie subalgebra of the actual strict matrix algebra.
The proof constructs the true polynomial logarithm of exp(t*A)*exp(t*B),
derives its finite dexp equation, and recovers all Lie coefficients by
induction. Its exponential image is thus an actual subgroup and equals the
group generated by the internal exponentials. -/

noncomputable section
namespace Hindman168
open Matrix Polynomial Set

variable {n : ℕ} {R : Type*} [CommRing R] [Algebra ℚ R]
local instance bchClosureMatrixLieRing : LieRing (Matrix (Fin n) (Fin n) R) :=
  LieRing.ofAssociativeRing
local instance bchClosurePolynomialLieRing : LieRing (Polynomial (Matrix (Fin n) (Fin n) R)) :=
  LieRing.ofAssociativeRing

 omit [Algebra ℚ R] in
 theorem matrixPolynomialEval_mem (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    {p : Polynomial (Matrix (Fin n) (Fin n) R)} (hp : p ∈ polynomialLieSubalgebra V) (r : R) :
    matrixPolynomialEval r p ∈ V := by
  change ((matPolyEquiv (R := R)).symm p).map (Polynomial.eval r) ∈ V
  rw [matPolyEquiv_symm_map_eval, Polynomial.eval_eq_sum, Polynomial.sum_def]
  apply V.toSubmodule.sum_mem
  intro k _
  rw [← map_pow]
  have hs : Matrix.scalar (Fin n) (r ^ k) = (r ^ k) • (1 : Matrix (Fin n) (Fin n) R) := by
    rw [Matrix.smul_one_eq_diagonal]
    rfl
  rw [hs, Algebra.mul_smul_comm, mul_one]
  exact V.smul_mem _ (hp k)

 theorem unitriangularPolynomialBCHCurve_inverse (A B : StrictUpperTriangular n R) :
    IsNilpotent.exp (-(unitriangularPolynomialBCHCurve A B)) =
      IsNilpotent.exp (-(monomial 1 B.val)) * IsNilpotent.exp (-(monomial 1 A.val)) := by
  have hn : IsNilpotent (unitriangularPolynomialBCHCurve A B) :=
    ⟨n, unitriangularPolynomialBCHCurve_nilpotent A B⟩
  apply (IsNilpotent.isUnit_exp hn).mul_left_cancel
  rw [IsNilpotent.exp_mul_exp_neg_self hn, unitriangularPolynomialBCHCurve_exponential]
  rw [mul_assoc, ← mul_assoc (IsNilpotent.exp (monomial 1 B.val)),
    IsNilpotent.exp_mul_exp_neg_self (polynomial_linear_curve_nilpotent B.property.nilpotent),
    one_mul, IsNilpotent.exp_mul_exp_neg_self (polynomial_linear_curve_nilpotent A.property.nilpotent)]

 theorem unitriangularPolynomialBCHCurve_coeff_mem
    (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n R)
    (A B : StrictUpperTriangular n R) (hA : A.val ∈ V) (hB : B.val ∈ V) (k : ℕ) :
    (unitriangularPolynomialBCHCurve A B).coeff k ∈ V := by
  have hn : IsNilpotent (unitriangularPolynomialBCHCurve A B) :=
    ⟨n, unitriangularPolynomialBCHCurve_nilpotent A B⟩
  apply polynomialLieSubalgebra_of_right_log_derivative V
    (unitriangularPolynomialBCHCurve_constant_zero A B) hn
  intro j
  rw [unitriangularPolynomialBCHCurve_inverse]
  exact unitriangularPolynomialBCHCurve_right_log_derivative_coeff_mem V hV A B hA hB j

 theorem unitriangular_bch_mem
    (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n R)
    (A B : StrictUpperTriangular n R) (hA : A.val ∈ V) (hB : B.val ∈ V) :
    (unitriangularLogarithm (unitriangularExponential A * unitriangularExponential B)).val ∈ V := by
  rw [← unitriangularPolynomialBCHCurve_endpoint]
  exact matrixPolynomialEval_mem V (unitriangularPolynomialBCHCurve_coeff_mem V hV A B hA hB) 1

 def unitriangularLieSubgroup
    (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n R) : Subgroup (Unitriangular n R) where
  carrier := unitriangularSubalgebraExpImage V
  one_mem' := by
    have hE : unitriangularExponential (0 : StrictUpperTriangular n R) = 1 := by
      apply unitriangular_val_injective
      exact matrixFiniteExp_zero
    apply (unitriangularSubalgebraExpImage_mem_iff V 1).mpr
    exact ⟨0, V.zero_mem, hE⟩
  mul_mem' {g h} hg hh := by
    change (unitriangularLogarithm (g * h)).val ∈ V
    have hp := unitriangular_bch_mem V hV (unitriangularLogarithm g) (unitriangularLogarithm h) hg hh
    simpa only [unitriangularExponential_logarithm] using hp
  inv_mem' {g} hg := (unitriangularSubalgebraExpImage_inverse_iff V g).mpr hg

 theorem unitriangularLieSubgroup_mem_iff
    (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n R) (g : Unitriangular n R) :
    g ∈ unitriangularLieSubgroup V hV ↔ (unitriangularLogarithm g).val ∈ V := Iff.rfl

 theorem unitriangularLieSubgroup_eq_generated
    (V : LieSubalgebra R (Matrix (Fin n) (Fin n) R))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n R) :
    unitriangularLieSubgroup V hV = unitriangularSubalgebraGenerated V := by
  apply le_antisymm
  · intro g hg
    exact Subgroup.subset_closure hg
  · exact (Subgroup.closure_le (K := unitriangularLieSubgroup V hV)).mpr (fun _ hg => hg)

 theorem unitriangularLieSubgroup_real_isClosed
    (V : LieSubalgebra ℝ (Matrix (Fin n) (Fin n) ℝ))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n ℝ) :
    IsClosed (unitriangularLieSubgroup V hV : Set (Unitriangular n ℝ)) :=
  unitriangularSubalgebraExpImage_isClosed V

 theorem unitriangularLieSubgroup_real_contractible
    (V : LieSubalgebra ℝ (Matrix (Fin n) (Fin n) ℝ))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n ℝ) :
    ContractibleSpace (unitriangularLieSubgroup V hV) :=
  unitriangularSubalgebraExpImage_contractible V

 theorem unitriangularLieSubgroup_real_simplyConnected
    (V : LieSubalgebra ℝ (Matrix (Fin n) (Fin n) ℝ))
    (hV : V ≤ strictUpperTriangularLieSubalgebra n ℝ) :
    SimplyConnectedSpace (unitriangularLieSubgroup V hV) :=
  unitriangularSubalgebraExpImage_simplyConnected V

end Hindman168
