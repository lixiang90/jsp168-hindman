import Hindman168.UnitriangularLieAlgebra

/-! The actual support layers are linearly generated by allowed elementary
matrices. This uses matrix coefficient expansion, not a postulated basis. -/

namespace Hindman168
open Matrix

variable {n : ℕ} {R : Type*} [CommRing R]
local instance generationMatrixLieRing : LieRing (Matrix (Fin n) (Fin n) R) := LieRing.ofAssociativeRing

 def unitriangularLieEntryTerm (A : UnitriangularLieAlgebra n R) (i j : Fin n) :
    UnitriangularLieAlgebra n R :=
  if hij : i < j then unitriangularLieSingle i j hij (A.val i j) else 0

 theorem unitriangularLieEntryTerm_value (A : UnitriangularLieAlgebra n R) (i j : Fin n) :
    (unitriangularLieEntryTerm A i j).val = Matrix.single i j (A.val i j) := by
  by_cases hij : i < j
  · simp only [unitriangularLieEntryTerm, dif_pos hij, unitriangularLieSingle]
  · have hz : A.val i j = 0 := A.property i j (by omega)
    simp [unitriangularLieEntryTerm, hij, hz]

 theorem unitriangularLie_eq_sum_entries (A : UnitriangularLieAlgebra n R) :
    A = ∑ i, ∑ j, unitriangularLieEntryTerm A i j := by
  apply Subtype.ext
  let f : UnitriangularLieAlgebra n R →ₗ[R] Matrix (Fin n) (Fin n) R :=
    (strictUpperTriangularLieSubalgebra n R).incl.toLinearMap
  change f A = f (∑ i, ∑ j, unitriangularLieEntryTerm A i j)
  rw [map_sum]
  simp_rw [map_sum]
  change A.val = ∑ i, ∑ j, (unitriangularLieEntryTerm A i j).val
  simpa only [unitriangularLieEntryTerm_value] using Matrix.matrix_eq_sum_single A.val

 theorem unitriangularLieDepth_le_of_singles (k : ℕ) (V : Submodule R (UnitriangularLieAlgebra n R))
    (hV : ∀ i j (hij : i < j), i.val + k ≤ j.val → ∀ c : R,
      unitriangularLieSingle i j hij c ∈ V) :
    (unitriangularLieDepth n k R : Submodule R (UnitriangularLieAlgebra n R)) ≤ V := by
  intro A hA
  rw [unitriangularLie_eq_sum_entries A]
  apply Submodule.sum_mem
  intro i _
  apply Submodule.sum_mem
  intro j _
  by_cases hij : i < j
  · rw [unitriangularLieEntryTerm, dif_pos hij]
    by_cases hgap : i.val + k ≤ j.val
    · exact hV i j hij hgap _
    · have hz : A.val i j = 0 := hA i j (by omega)
      have heq : unitriangularLieSingle i j hij (A.val i j) = 0 := by
        apply Subtype.ext
        simp [unitriangularLieSingle, hz]
      rw [heq]
      exact V.zero_mem
  · rw [unitriangularLieEntryTerm, dif_neg hij]
    exact V.zero_mem

 theorem unitriangularLieDepth_eq_span (k : ℕ) :
    (unitriangularLieDepth n k R : Submodule R (UnitriangularLieAlgebra n R)) =
      Submodule.span R {A | ∃ i j, ∃ hij : i < j, ∃ c : R, i.val + k ≤ j.val ∧
        A = unitriangularLieSingle i j hij c} := by
  apply le_antisymm
  · apply unitriangularLieDepth_le_of_singles
    intro i j hij hgap c
    exact Submodule.subset_span ⟨i, j, hij, c, hgap, rfl⟩
  · apply Submodule.span_le.mpr
    rintro A ⟨i, j, hij, c, hgap, rfl⟩
    exact unitriangularLieSingle_depth k i j hij hgap c

end Hindman168
