import Hindman168.BoundedRationalModelCodes
import OAI.Combinatorics.Progressions.Nilpotent.NiltestBasepointNormalization

/-!
Actual rational covers for the bounded native-model argument.

The cover lattice is the subgroup generated by the inner coordinate grid.
It is canonical from the coordinate Lie bracket and grid scale, is contained
in every lattice with those data, and is itself discrete and cocompact after
realification. No finiteness or geometric realization is postulated.
-/

namespace Hindman168

open Module OAI.Erdos3
open scoped TensorProduct NNReal

namespace OriginalBoundedNativeModels

section GridCover

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {s d : ℕ}
  (D : RationalFilteredNilmanifold L s d)

/-- The subgroup generated by the displayed inner grid, not an arbitrary
chosen lattice of a signature. -/
noncomputable def gridGeneratedLattice : Subgroup D.filtration.Group :=
  Subgroup.closure {g | D.basis.equivFun g.coord ∈ scaledIntegerGrid D.grid}

theorem gridGeneratedLattice_le : gridGeneratedLattice D ≤ D.lattice := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  exact (bchSubgroupCoordinates_repr D.basis D.lattice g).mp (D.inner_grid hg)

theorem gridGeneratedLattice_inner :
    scaledIntegerGrid D.grid ⊆ bchSubgroupCoordinates D.basis (gridGeneratedLattice D) := by
  intro x hx
  change (⟨D.basis.equivFun.symm x⟩ : D.filtration.Group) ∈ gridGeneratedLattice D
  apply Subgroup.subset_closure
  change D.basis.equivFun (D.basis.equivFun.symm x) ∈ scaledIntegerGrid D.grid
  simpa only [LinearEquiv.apply_symm_apply] using hx

theorem gridGeneratedLattice_outer :
    bchSubgroupCoordinates D.basis (gridGeneratedLattice D) ⊆ denominatorGrid D.grid := by
  intro x hx
  apply D.outer_grid
  exact gridGeneratedLattice_le D hx

/-- A genuine rational filtered nilmanifold with a signature-determined
cover lattice; its grid and Lie geometry are unchanged. -/
noncomputable def gridCover : RationalFilteredNilmanifold L s d where
  filtration := D.filtration
  basis := D.basis
  layerBasis := D.layerBasis
  lattice := gridGeneratedLattice D
  grid := D.grid
  grid_pos := D.grid_pos
  inner_grid := gridGeneratedLattice_inner D
  outer_grid := gridGeneratedLattice_outer D

theorem gridCover_geometry {p : ℝ} (hD : D.GeometryComplexityLE p) :
    (gridCover D).GeometryComplexityLE p := hD

end GridCover

theorem rationalHeight_of_logHeight {q : ℚ} {p : ℝ}
    (hq : rationalLogHeight q ≤ p) :
    q.num.natAbs ≤ ⌈Real.exp p⌉₊ ∧ q.den ≤ ⌈Real.exp p⌉₊ := by
  have hd : (0 : ℝ) < q.den := by exact_mod_cast q.den_pos
  have h := (Real.log_le_iff_le_exp
    (lt_of_lt_of_le hd (le_max_right (q.num.natAbs : ℝ) (q.den : ℝ)))).mp hq
  have hn := (le_max_left (q.num.natAbs : ℝ) (q.den : ℝ)).trans h
  have hd' := (le_max_right (q.num.natAbs : ℝ) (q.den : ℝ)).trans h
  exact ⟨Nat.cast_le.mp (hn.trans (Nat.le_ceil _)),
    Nat.cast_le.mp (hd'.trans (Nat.le_ceil _))⟩


end OriginalBoundedNativeModels
end Hindman168
