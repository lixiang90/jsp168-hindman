import Hindman168.BoundedLieWords
import Mathlib.RingTheory.Finiteness.Basic

/-! The Lie subalgebra generated by finitely many original vectors in
a nilpotent Lie algebra has an actual finite module spanning set. Actual
Jacobi gives a stabilizer Lie subalgebra, and actual lower-central vanishing
bounds the length of the original adjoint words. -/

namespace Hindman168
open Function Set Submodule

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

def lieLinearSubspaceStabilizer (P : Submodule R L) : LieSubalgebra R L where
  carrier := {x : L | ∀ w ∈ P, ⁅x, w⁆ ∈ P}
  zero_mem' := by intro w _; rw [zero_lie]; exact P.zero_mem
  add_mem' := by
    intro x y hx hy w hw
    rw [add_lie]
    exact P.add_mem (hx w hw) (hy w hw)
  smul_mem' := by
    intro r x hx w hw
    rw [smul_lie]
    exact P.smul_mem r (hx w hw)
  lie_mem' := by
    intro x y hx hy w hw
    rw [lie_lie]
    exact P.sub_mem (hx _ (hy w hw)) (hy _ (hx w hw))

 theorem boundedLieWord_span_generator_stable (s : Set L) {c : ℕ}
    (hc : LieModule.lowerCentralSeries R L L c = ⊥) {x : L} (hx : x ∈ s)
    {w : L} (hw : w ∈ span R (boundedLieWordValues s c)) :
    ⁅x, w⁆ ∈ span R (boundedLieWordValues s c) := by
  let P : Submodule R L := span R (boundedLieWordValues s c)
  have hle : P ≤ P.comap (LieModule.toEnd R L L x) := by
    apply span_le.mpr
    rintro z ⟨⟨⟨xs, hxs⟩, y⟩, rfl⟩
    change ⁅x, lieWordValue (xs.map (fun a : s => a.val)) y.val⁆ ∈ P
    by_cases hl : xs.length < c
    · exact subset_span ⟨(⟨⟨x, hx⟩ :: xs, by simp only [List.length_cons]; omega⟩, y), rfl⟩
    · have hz : lieWordValue (xs.map (fun a : s => a.val)) y.val = 0 :=
        lieWordValue_zero_of_lowerCentral_bot hc _ _ (by simpa only [List.length_map] using Nat.le_of_not_gt hl)
      rw [hz, lie_zero]
      exact P.zero_mem
  exact hle hw

 theorem boundedLieWord_span_le_lieSpan (s : Set L) (c : ℕ) :
    span R (boundedLieWordValues s c) ≤ (LieSubalgebra.lieSpan R L s).toSubmodule := by
  apply span_le.mpr
  rintro z ⟨⟨xs, w⟩, rfl⟩
  exact lieWordValue_subtype_mem_lieSpan s xs.val w

 theorem boundedLieWord_span_lie_mem (s : Set L) {c : ℕ}
    (hc : LieModule.lowerCentralSeries R L L c = ⊥) {x y : L}
    (hx : x ∈ span R (boundedLieWordValues s c))
    (hy : y ∈ span R (boundedLieWordValues s c)) :
    ⁅x, y⁆ ∈ span R (boundedLieWordValues s c) := by
  have hle : LieSubalgebra.lieSpan R L s ≤
      lieLinearSubspaceStabilizer (span R (boundedLieWordValues s c)) := by
    apply LieSubalgebra.lieSpan_le.mpr
    intro v hv w hw
    exact boundedLieWord_span_generator_stable s hc hv hw
  exact hle (boundedLieWord_span_le_lieSpan s c hx) y hy

 theorem nilpotentLieSpan_eq_bounded_word_span (s : Set L) {c : ℕ}
    (hc : LieModule.lowerCentralSeries R L L c = ⊥) :
    (LieSubalgebra.lieSpan R L s).toSubmodule = span R (boundedLieWordValues s c) := by
  let A : LieSubalgebra R L := {
    span R (boundedLieWordValues s c) with
    lie_mem' := fun hx hy => boundedLieWord_span_lie_mem s hc hx hy }
  apply le_antisymm
  · have hle : LieSubalgebra.lieSpan R L s ≤ A := by
      apply LieSubalgebra.lieSpan_le.mpr
      intro x hx
      exact subset_span (subset_boundedLieWordValues s c hx)
    exact hle
  · exact boundedLieWord_span_le_lieSpan s c

 theorem nilpotent_finite_lieSpan_fg (s : Set L) (hs : s.Finite) {c : ℕ}
    (hc : LieModule.lowerCentralSeries R L L c = ⊥) :
    (LieSubalgebra.lieSpan R L s).toSubmodule.FG := by
  rw [nilpotentLieSpan_eq_bounded_word_span s hc]
  exact Submodule.fg_span (boundedLieWordValues_finite s hs c)

end Hindman168
