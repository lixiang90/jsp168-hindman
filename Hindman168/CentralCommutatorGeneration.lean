import Hindman168.CentralCommutatorBilinear
import Hindman168.FiniteCentralQuotientCommutator
import Mathlib.GroupTheory.Finiteness

/-! Central commutators of generated subgroups are generated by the actual
generator pairs. Adjoining an actual central subgroup contributes no new
commutators. These are algebraic inputs for successive lower-central factors. -/

namespace Hindman168
open Set Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G]

theorem commutator_closure_eq_closure_pairs_of_central (s t : Set G)
    (hc : ⁅Subgroup.closure s, Subgroup.closure t⁆ ≤ Subgroup.center G) :
    ⁅Subgroup.closure s, Subgroup.closure t⁆ =
      Subgroup.closure {g | ∃ a ∈ s, ∃ b ∈ t, ⁅a, b⁆ = g} := by
  let K := Subgroup.closure {g | ∃ a ∈ s, ∃ b ∈ t, ⁅a, b⁆ = g}
  have hfirst : ∀ a ∈ Subgroup.closure s, ∀ b ∈ t, ⁅a, b⁆ ∈ K := by
    intro a ha b hb
    let f := centralCommutatorLeftHom (Subgroup.closure s) (Subgroup.closure t)
      hc ⟨b, Subgroup.subset_closure hb⟩
    have hle : Subgroup.closure ((↑) ⁻¹' s : Set (Subgroup.closure s)) ≤ K.comap f := by
      apply (Subgroup.closure_le (K := K.comap f)).mpr
      intro x hx
      exact Subgroup.subset_closure ⟨(x : G), hx, b, hb, rfl⟩
    rw [Subgroup.closure_closure_coe_preimage] at hle
    exact hle (Subgroup.mem_top (⟨a, ha⟩ : Subgroup.closure s))
  apply le_antisymm
  · apply Subgroup.commutator_le.mpr
    intro a ha b hb
    let f := centralCommutatorRightHom (Subgroup.closure s) (Subgroup.closure t)
      hc ⟨a, ha⟩
    have hle : Subgroup.closure ((↑) ⁻¹' t : Set (Subgroup.closure t)) ≤ K.comap f := by
      apply (Subgroup.closure_le (K := K.comap f)).mpr
      intro x hx
      exact hfirst a ha (x : G) hx
    rw [Subgroup.closure_closure_coe_preimage] at hle
    exact hle (Subgroup.mem_top (⟨b, hb⟩ : Subgroup.closure t))
  · apply (Subgroup.closure_le (K := ⁅Subgroup.closure s, Subgroup.closure t⁆)).mpr
    rintro g ⟨a, ha, b, hb, rfl⟩
    exact Subgroup.commutator_mem_commutator
      (Subgroup.subset_closure ha) (Subgroup.subset_closure hb)

theorem commutator_pairs_finite (s t : Set G) (hs : s.Finite) (ht : t.Finite) :
    ({g | ∃ a ∈ s, ∃ b ∈ t, ⁅a, b⁆ = g} : Set G).Finite := by
  have he : {g | ∃ a ∈ s, ∃ b ∈ t, ⁅a, b⁆ = g} =
      (fun p : G × G => ⁅p.1, p.2⁆) '' (s ×ˢ t) := by
    ext g
    constructor
    · rintro ⟨a, ha, b, hb, rfl⟩
      exact ⟨(a, b), ⟨ha, hb⟩, rfl⟩
    · rintro ⟨⟨a, b⟩, ⟨ha, hb⟩, rfl⟩
      exact ⟨a, ha, b, hb, rfl⟩
  rw [he]
  exact (hs.prod ht).image _

theorem commutator_closure_fg_of_central (s t : Set G)
    (hs : s.Finite) (ht : t.Finite)
    (hc : ⁅Subgroup.closure s, Subgroup.closure t⁆ ≤ Subgroup.center G) :
    ⁅Subgroup.closure s, Subgroup.closure t⁆.FG := by
  apply (Subgroup.fg_iff _).mpr
  exact ⟨{g | ∃ a ∈ s, ∃ b ∈ t, ⁅a, b⁆ = g},
    (commutator_closure_eq_closure_pairs_of_central s t hc).symm,
    commutator_pairs_finite s t hs ht⟩

theorem commutator_sup_central_left_eq (A B C : Subgroup G)
    (hC : C ≤ Subgroup.center G) : ⁅A ⊔ C, B⁆ = ⁅A, B⁆ := by
  letI : C.Normal := ⟨by
    intro x hx g
    rw [Subgroup.mem_center_iff.mp (hC hx) g]
    simpa only [mul_assoc, mul_inv_cancel, mul_one] using hx⟩
  apply le_antisymm
  · apply Subgroup.commutator_le.mpr
    intro a ha b hb
    obtain ⟨x, hx, z, hz, rfl⟩ := Subgroup.mem_sup_of_normal_right.mp ha
    rw [commutator_right_central_multiplier_left x b z (hC hz)]
    exact Subgroup.commutator_mem_commutator hx hb
  · exact Subgroup.commutator_mono le_sup_left le_rfl

end Hindman168
