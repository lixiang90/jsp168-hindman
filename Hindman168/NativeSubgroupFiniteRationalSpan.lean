import Hindman168.NativeLieRationalAlgebra
import Hindman168.NativeLatticeFiniteGeneration
import Hindman168.NilpotentFiniteLieSpan
import Mathlib.LinearAlgebra.FiniteDimensional.Defs

/-! The actual rational logarithmic span of a subgroup generated by a
specified set is exactly the original rational Lie span of the original
generator logarithms. Actual rational BCH and global inverse laws give
both inclusions. Finite generation and actual nilpotent word truncation
therefore give finite rational dimension for the actual specified lattice. -/

namespace Hindman168
open Function Set Submodule
open scoped Manifold ContDiff

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] [Module ℚ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G] [Group.IsNilpotent G]
  [FiniteDimensional ℝ E] [ConnectedSpace G] [SimplyConnectedSpace G]

attribute [local instance] lieGroup_smooth_min_three

 theorem nativeSubgroupRationalLogSpan_eq_lieSpan_of_closure (Γ : Subgroup G)
    (s : Set G) (hs : Subgroup.closure s = Γ) :
    nativeSubgroupRationalLogSpan (E := E) (I := I) Γ =
      (LieSubalgebra.lieSpan ℚ (GroupLieAlgebra I G)
        ((nativeLieGlobalLogarithm (E := E) (I := I) (G := G)) '' s)).toSubmodule := by
  let log : G → E := nativeLieGlobalLogarithm (E := E) (I := I) (G := G)
  let A : LieSubalgebra ℚ (GroupLieAlgebra I G) := LieSubalgebra.lieSpan ℚ _ (log '' s)
  let V : Submodule ℚ E := A.toSubmodule
  have hbr : nativeLieRationalBracketClosed (E := E) (I := I) (G := G) V :=
    fun x y hx hy => A.lie_mem hx hy
  let K : Subgroup G := nativeLieRationalExponentialSubgroup (I := I) (G := G) V hbr
  have hΓK : Γ ≤ K := by
    rw [← hs]
    apply (Subgroup.closure_le (K := K)).mpr
    intro g hg
    apply (nativeLieRationalExponentialSubgroup_mem_logarithm_iff (E := E) V hbr g).mpr
    exact LieSubalgebra.subset_lieSpan (R := ℚ) (L := GroupLieAlgebra I G) ⟨g, hg, rfl⟩
  apply le_antisymm
  · apply span_le.mpr
    rintro v ⟨g, hg, rfl⟩
    exact (nativeLieRationalExponentialSubgroup_mem_logarithm_iff (E := E) V hbr g).mp (hΓK hg)
  · have hle : A ≤ nativeLieRationalSubalgebra
        (nativeSubgroupRationalLogSpan (E := E) (I := I) Γ)
        (nativeSubgroupRationalLogSpan_bracket_closed (E := E) (I := I) Γ) := by
      apply LieSubalgebra.lieSpan_le.mpr
      rintro v ⟨g, hg, rfl⟩
      have hgΓ : g ∈ Γ := hs ▸ Subgroup.subset_closure hg
      exact nativeSubgroup_logarithm_mem_span (E := E) (I := I) Γ hgΓ
    exact hle

 theorem nativeSubgroupRationalLogSpan_fg_of_fg (Γ : Subgroup G) (hΓ : Γ.FG) :
    (nativeSubgroupRationalLogSpan (E := E) (I := I) Γ).FG := by
  obtain ⟨s, hs, hsf⟩ := Γ.fg_iff.mp hΓ
  rw [nativeSubgroupRationalLogSpan_eq_lieSpan_of_closure (E := E) (I := I) Γ s hs]
  exact nilpotent_finite_lieSpan_fg (R := ℚ) (L := GroupLieAlgebra I G) _
    (hsf.image (nativeLieGlobalLogarithm (E := E) (I := I) (G := G)))
    (nativeLieRationalLowerCentral_nilpotencyClass_bot (E := E) (I := I) (G := G))

 theorem nativeLatticeRationalLogSpan_finiteDimensional (Γ : Subgroup G)
    [DiscreteTopology Γ] [CompactSpace (G ⧸ Γ)] :
    FiniteDimensional ℚ (nativeSubgroupRationalLogSpan (E := E) (I := I) Γ) :=
  (Submodule.fg_iff_finiteDimensional _).mp
    (nativeSubgroupRationalLogSpan_fg_of_fg (E := E) (I := I) Γ (nativeLattice_fg (I := I) Γ))

 theorem nativeLatticeRationalLogSpan_finite_spanning_set (Γ : Subgroup G)
    [DiscreteTopology Γ] [CompactSpace (G ⧸ Γ)] :
    ∃ s : Set E, s.Finite ∧ s ⊆ nativeSubgroupRationalLogSpan (E := E) (I := I) Γ ∧
      span ℚ s = nativeSubgroupRationalLogSpan (E := E) (I := I) Γ := by
  obtain ⟨s, hsf, hs⟩ := Submodule.fg_def.mp
    (nativeSubgroupRationalLogSpan_fg_of_fg (E := E) (I := I) Γ (nativeLattice_fg (I := I) Γ))
  refine ⟨s, hsf, ?_, hs⟩
  rw [← hs]
  exact subset_span

end Hindman168
