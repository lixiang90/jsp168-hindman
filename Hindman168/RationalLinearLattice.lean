import Hindman168.RationalLinearDenominators

/-! Rational linear layers relative to an actual integer submodule. Clearing
rational denominators proves that their integer intersections span them.
No cocompactness is assumed in the definition of rationality. -/

namespace Hindman168
open Submodule

section Algebraic
variable {E : Type*} [AddCommGroup E] [Module ℝ E] [Module ℚ E]

/-- Rationality for the rational structure generated by `L`. -/
def RationalLinearSubspace (L : Submodule ℤ E) (V : Submodule ℝ E) : Prop :=
  span ℝ ((V : Set E) ∩ (span ℚ (L : Set E) : Set E)) = V

/-- The actual integer intersection, regarded as a submodule of the layer. -/
noncomputable def linearLayerLattice (L : Submodule ℤ E) (V : Submodule ℝ E) :
    Submodule ℤ V := L.comap (V.subtype.restrictScalars ℤ)

/-- Clearing denominators inside the layer turns rational spanning into
integer-intersection spanning. -/
theorem rationalLinearSubspace_integer_span (L : Submodule ℤ E) (V : Submodule ℝ E)
    (hV : RationalLinearSubspace L V) :
    span ℝ ((V : Set E) ∩ (L : Set E)) = V := by
  apply le_antisymm
  · exact span_le.mpr fun _ hx => hx.1
  · calc V = span ℝ ((V : Set E) ∩ (span ℚ (L : Set E) : Set E)) := hV.symm
         _ ≤ span ℝ ((V : Set E) ∩ (L : Set E)) := ?_
    apply span_le.mpr
    intro x hx
    obtain ⟨n, hn, hnx⟩ := rationalSpan_integer_multiple L hx.2
    have hnv : n • x ∈ V := V.toAddSubgroup.zsmul_mem hx.1 n
    have hm : n • x ∈ span ℝ ((V : Set E) ∩ (L : Set E)) :=
      subset_span ⟨hnv, hnx⟩
    rw [← Int.cast_smul_eq_zsmul ℝ] at hm
    exact (smul_mem_iff _ (by exact_mod_cast hn : (n : ℝ) ≠ 0)).mp hm

/-- The converse holds since every integer lattice vector is rational. -/
theorem rationalLinearSubspace_iff_integer_span (L : Submodule ℤ E) (V : Submodule ℝ E) :
    RationalLinearSubspace L V ↔ span ℝ ((V : Set E) ∩ (L : Set E)) = V := by
  constructor
  · exact rationalLinearSubspace_integer_span L V
  · intro h
    apply le_antisymm
    · exact span_le.mpr fun _ hx => hx.1
    · calc V = span ℝ ((V : Set E) ∩ (L : Set E)) := h.symm
           _ ≤ span ℝ ((V : Set E) ∩ (span ℚ (L : Set E) : Set E)) :=
             span_mono fun _ hx => ⟨hx.1, subset_span hx.2⟩

/-- The restricted lattice spans its layer, not just its image in the ambient
space. -/
theorem rationalLinearSubspace_layer_span_top (L : Submodule ℤ E) (V : Submodule ℝ E)
    (hV : RationalLinearSubspace L V) :
    span ℝ (linearLayerLattice L V : Set V) = ⊤ := by
  apply eq_top_iff.mpr
  intro x _
  have hs := rationalLinearSubspace_integer_span L V hV
  have hx : x.val ∈ span ℝ ((V : Set E) ∩ (L : Set E)) := by rw [hs]; exact x.property
  have heq : V.subtype '' (linearLayerLattice L V : Set V) = (V : Set E) ∩ (L : Set E) := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact ⟨z.property, hz⟩
    · intro hy
      exact ⟨⟨y, hy.1⟩, hy.2, rfl⟩
  rw [← heq, ← Submodule.map_span] at hx
  obtain ⟨y, hy, hyx⟩ := hx
  have hxy : y = x := Subtype.ext hyx
  exact hxy ▸ hy

end Algebraic

section Normed
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Discreteness is inherited by the actual intersection via the injective
continuous inclusion of the layer. -/
theorem linearLayerLattice_discrete (L : Submodule ℤ E) [DiscreteTopology L]
    (V : Submodule ℝ E) : DiscreteTopology (linearLayerLattice L V) := by
  exact ZLattice.comap_discreteTopology ℝ L continuous_subtype_val Subtype.val_injective

variable [Module ℚ E]

/-- Every rational layer of a discrete integer submodule has a full integer
lattice. Neither ambient nor layer quotient compactness is a premise. -/
theorem rationalLinearSubspace_isZLattice (L : Submodule ℤ E) [DiscreteTopology L]
    (V : Submodule ℝ E) (hV : RationalLinearSubspace L V) :
    letI := linearLayerLattice_discrete L V
    IsZLattice ℝ (linearLayerLattice L V) := by
  letI := linearLayerLattice_discrete L V
  exact ⟨rationalLinearSubspace_layer_span_top L V hV⟩

end Normed
end Hindman168
